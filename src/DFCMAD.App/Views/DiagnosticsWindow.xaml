<Window x:Class="DFCMAD.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DFCMAD Diagnostics"
        Width="780"
        Height="610"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,16,18,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnostics" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Health, audio state, settings, logs, and raw details."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Width="72"
                        Height="34"
                        Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Enforcement" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding EnforcementSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Devices" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding DeviceSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Startup" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding StartupSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Last error" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding LastErrorSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SettingsFile}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LogFolder}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="82" Margin="6,0,0,0" />
                        <Button Content="Copy" Command="{Binding CopyCommand}" Width="76" Margin="6,0,0,0" />
                        <Button Content="Logs" Command="{Binding OpenLogFolderCommand}" Width="76" Margin="6,0,0,0" />
                        <Button Content="Force refresh" Command="{Binding ForceRefreshDevicesCommand}" Width="112" Margin="6,0,0,0" />
                        <Button Content="Enforce now" Command="{Binding EnforceNowCommand}" Width="104" Margin="6,0,0,0" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="1">
                    <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             Foreground="#FFE5E7EB"
                             BorderThickness="0"
                             Padding="12"
                             TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
