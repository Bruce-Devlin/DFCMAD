<Window x:Class="DFCMAD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DFCMAD"
        Width="600"
        MinWidth="560"
        MaxWidth="660"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DFCMAD" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Audio device lock"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#FF111827"
                        BorderBrush="{Binding State.Status, Converter={StaticResource StatusBrushConverter}}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="11,5"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding State.Status, Converter={StaticResource StatusBrushConverter}}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="#FF1A202A"
                    BorderBrush="#FF2F3B4D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding HeaderStatusText}" FontSize="14" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output locked to" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LockedOutputText}"
                                   ToolTip="{Binding LockedOutputText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Input locked to" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LockedInputText}"
                                   ToolTip="{Binding LockedInputText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding LastEventText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,9,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="#FF223044"
                    BorderBrush="#FF3A516C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsFirstRunVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Choose the devices Windows should keep."
                               FontWeight="SemiBold" />
                    <TextBlock Text="Pick an output and input device. DFCMAD will stay in the tray and restore them when Windows changes them."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,10" />
                    <Button Content="Finish setup"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding FinishSetupCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Output" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Speaker or headphone device" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#FF111827"
                                    BorderBrush="{Binding State.Status, Converter={StaticResource StatusBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding OutputStatusLabel}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Preferred device" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  IsEnabled="{Binding HasOutputDevices}"
                                  MaxDropDownHeight="250" />
                        <TextBlock Text="{Binding OutputEmptyText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding IsOutputEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="Windows default" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,3" />
                        <TextBlock Text="{Binding OutputDefaultName}"
                                   ToolTip="{Binding OutputDefaultName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutputHelpText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasOutputHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Input" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Microphone device" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#FF111827"
                                    BorderBrush="{Binding State.Status, Converter={StaticResource StatusBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding InputStatusLabel}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Preferred device" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  IsEnabled="{Binding HasInputDevices}"
                                  MaxDropDownHeight="250" />
                        <TextBlock Text="{Binding InputEmptyText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding IsInputEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="Windows default" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,3" />
                        <TextBlock Text="{Binding InputDefaultName}"
                                   ToolTip="{Binding InputDefaultName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InputHelpText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasInputHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Enforce now"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding EnforceNowCommand}"
                                MinWidth="128"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding PauseButtonText}"
                                Command="{Binding TogglePauseCommand}"
                                MinWidth="128" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,0,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lock output" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding EnforceOutputEnabled}" />
                            </Grid>
                            <Grid Margin="0,0,18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lock input" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding EnforceInputEnabled}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              IsChecked="{Binding StartWithWindowsEnabled}" />
                            </Grid>
                            <Expander Foreground="{StaticResource TextBrush}"
                                      Background="Transparent"
                                      BorderBrush="Transparent">
                                <Expander.Header>
                                    <TextBlock Text="Advanced" Foreground="{StaticResource MutedTextBrush}" />
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock all Windows roles"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  IsChecked="{Binding EnforceAllRolesEnabled}" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding LastEnforcementSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock Text="{Binding LastWindowsChangeSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Refresh devices" Style="{StaticResource LinkButtonStyle}" Command="{Binding RefreshCommand}" />
                    <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button Content="Diagnostics" Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenDiagnosticsCommand}" />
                    <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button Content="Logs" Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenLogsCommand}" />
                    <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button Content="Hide" Style="{StaticResource LinkButtonStyle}" Command="{Binding HideCommand}" />
                    <TextBlock Text="{Binding AppVersionSummary}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
